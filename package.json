{
  "name": "nestjs-typeorm-template",
  "version": "1.0.1",
  "description": "",
  "author": "UAhmadSoft",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "push": "npm run build && git add . && git commit -m ",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=production PORT=6011 nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:up": "npm run build && typeorm migration:run --d ./dist/src/infrastructure/config/typeorm/typeorm.datasource.js",
    "migration:down": "typeorm migration:revert --d ./dist/src/infrastructure/config/typeorm/typeorm.datasource.js",
    "migration:show": "typeorm migration:show --d ./dist/src/infrastructure/config/typeorm/typeorm.datasource.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.6.1",
